<?xml version="1.0" encoding="UTF-8"?>
<project child.project.url.inherit.append.path="false" xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>top.egon</groupId>
        <artifactId>stellar-enclosure-tianshu</artifactId>
        <version>0.0.1</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>stellar-enclosure-tianshu-admin</artifactId>
    <packaging>jar</packaging>
    <name>stellar-enclosure-tianshu-admin</name>
    <description>Admin service for Stellar Enclosure dynamic config center.</description>

    <properties>
        <stellar-enclosure.yuheng.version>0.0.1</stellar-enclosure.yuheng.version>
        <maven.deploy.skip>true</maven.deploy.skip>
        <gpg.skip>true</gpg.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>top.egon</groupId>
            <artifactId>stellar-enclosure-tianquan-jianshen-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>top.egon</groupId>
            <artifactId>stellar-enclosure-tianquan-shoubing-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>top.egon</groupId>
            <artifactId>stellar-enclosure-yuheng-starter</artifactId>
            <version>${stellar-enclosure.yuheng.version}</version>
        </dependency>
        <dependency>
            <groupId>top.egon</groupId>
            <artifactId>stellar-enclosure-yuheng-starter-openapi-webmvc</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>top.egon</groupId>
            <artifactId>stellar-enclosure-component-common-core</artifactId>
        </dependency>
        <dependency>
            <groupId>top.egon</groupId>
            <artifactId>stellar-enclosure-component-common-mybatis-plus-sharding-jdbc-ext-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>top.egon</groupId>
            <artifactId>stellar-enclosure-component-transactional-outbox-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>
        <dependency>
            <groupId>top.egon</groupId>
            <artifactId>stellar-enclosure-component-common-id-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>top.egon</groupId>
            <artifactId>stellar-enclosure-tianshu-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>top.egon</groupId>
            <artifactId>stellar-enclosure-component-rpc-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>top.egon</groupId>
            <artifactId>stellar-enclosure-component-rpc-tianshu-adapter</artifactId>
        </dependency>
        <dependency>
            <groupId>top.egon</groupId>
            <artifactId>stellar-enclosure-component-common-trace-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>stellar-enclosure-tianshu-admin</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>**/DdcConfigOutboxIntegrationTest.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring.boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <classifier>exec</classifier>
                    <mainClass>top.egon.cola.component.tianshu.admin.DynamicConfigCenterAdminApplication</mainClass>
                    <layout>JAR</layout>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>permission-producer</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>default-compile</id>
                                <configuration>
                                    <annotationProcessorPaths combine.children="append">
                                        <path>
                                            <groupId>top.egon</groupId>
                                            <artifactId>stellar-enclosure-tianquan-jianshen-processor</artifactId>
                                            <version>${project.version}</version>
                                        </path>
                                    </annotationProcessorPaths>
                                    <compilerArgs>
                                        <arg>-Apac.business=xingyuan</arg>
                                        <arg>-Apac.application=tianshu</arg>
                                        <arg>-Apac.producer=tianshu-java</arg>
                                        <arg>-Apac.module=${project.artifactId}</arg>
                                        <arg>-Apac.expectedModules=stellar-enclosure-tianshu-starter,stellar-enclosure-tianshu-admin</arg>
                                        <arg>-Apac.ownedKeyPrefixes=tianshu.api.,tianshu.field.</arg>
                                        <arg>-Apac.managedPackages=top.egon.cola.component.tianshu.admin.controller</arg>
                                        <arg>-Apac.repository=tianshu-service</arg>
                                        <arg>-Apac.commit=${permission.commit}</arg>
                                        <arg>-Apac.buildId=${permission.buildId}</arg>
                                        <arg>-Apac.version=${project.version}</arg>
                                    </compilerArgs>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <permission.producer.enabled>true</permission.producer.enabled>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <dependencies>
                            <dependency>
                                <groupId>top.egon</groupId>
                                <artifactId>stellar-enclosure-tianquan-jianshen-manifest-cli</artifactId>
                                <version>${project.version}</version>
                            </dependency>
                        </dependencies>
                        <executions>
                            <execution>
                                <id>aggregate-permission-manifest</id>
                                <phase>prepare-package</phase>
                                <goals><goal>java</goal></goals>
                                <configuration>
                                    <mainClass>top.egon.cola.platform.tianquan.jianshen.manifestcli.PermissionManifestBuildCli</mainClass>
                                    <includePluginDependencies>true</includePluginDependencies>
                                    <includeProjectDependencies>false</includeProjectDependencies>
                                    <addOutputToClasspath>false</addOutputToClasspath>
                                    <addResourcesToClasspath>false</addResourcesToClasspath>
                                    <executableDependency>
                                        <groupId>top.egon</groupId>
                                        <artifactId>stellar-enclosure-tianquan-jianshen-manifest-cli</artifactId>
                                    </executableDependency>
                                    <arguments>
                                        <argument>--module</argument>
                                        <argument>${project.basedir}/../stellar-enclosure-tianshu-starter/target/stellar-enclosure-tianshu-starter-${project.version}.jar</argument>
                                        <argument>--module</argument>
                                        <argument>${project.build.outputDirectory}</argument>
                                        <argument>--output</argument>
                                        <argument>${project.build.outputDirectory}/META-INF/permissions/manifest-v1.json</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>verify-permission-artifact</id>
                                <phase>verify</phase>
                                <goals><goal>java</goal></goals>
                                <configuration>
                                    <mainClass>top.egon.cola.platform.tianquan.jianshen.manifestcli.PermissionManifestBuildCli</mainClass>
                                    <includePluginDependencies>true</includePluginDependencies>
                                    <includeProjectDependencies>false</includeProjectDependencies>
                                    <addOutputToClasspath>false</addOutputToClasspath>
                                    <addResourcesToClasspath>false</addResourcesToClasspath>
                                    <executableDependency>
                                        <groupId>top.egon</groupId>
                                        <artifactId>stellar-enclosure-tianquan-jianshen-manifest-cli</artifactId>
                                    </executableDependency>
                                    <arguments>
                                        <argument>--artifact</argument>
                                        <argument>${project.build.directory}/${project.build.finalName}-exec.jar</argument>
                                        <argument>--output</argument>
                                        <argument>${project.build.directory}/permissions/artifact-evidence.json</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>tianshu-permission-metadata-it</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>tianshu-permission-metadata-it</id>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                                <configuration>
                                    <includes>
                                        <include>**/DdcPermissionMetadataPersistenceIT.java</include>
                                        <include>**/DdcI18nImportConcurrencyIT.java</include>
                                        <include>**/DdcI18nDraftPublishIT.java</include>
                                    </includes>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>tianshu-active-active</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>tianshu-active-active-it</id>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                                <configuration>
                                    <includes>
                                        <include>**/DdcActiveActiveAdminIT.java</include>
                                    </includes>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>tianshu-redis-sentinel</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>tianshu-redis-sentinel-it</id>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                                <configuration>
                                    <includes>
                                        <include>**/DdcRedisSentinelIT.java</include>
                                    </includes>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>tianshu-redis-cluster</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>tianshu-redis-cluster-it</id>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                                <configuration>
                                    <includes>
                                        <include>**/DdcRedisClusterIT.java</include>
                                    </includes>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>tianshu-ai-persistence-it</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>tianshu-ai-persistence-it</id>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                                <configuration>
                                    <includes>
                                        <include>**/DdcAiPersistenceIT.java</include>
                                        <include>**/DdcAiConcurrencyIT.java</include>
                                        <include>**/DdcAiPromotionIT.java</include>
                                        <include>**/DdcTenantRedisIT.java</include>
                                        <include>**/DdcTianshuDdlIT.java</include>
                                        <include>**/DdcLegacyMigrationIT.java</include>
                                        <include>**/DdcConfigOutboxIntegrationTest.java</include>
                                        <include>**/DdcLifecycleUniqueIT.java</include>
                                        <include>**/DdcAiFeedbackPersistenceIT.java</include>
                                        <include>**/DdcAiOptimizationConcurrencyIT.java</include>
                                        <include>**/DdcAiOptimizationPublishIT.java</include>
                                    </includes>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
