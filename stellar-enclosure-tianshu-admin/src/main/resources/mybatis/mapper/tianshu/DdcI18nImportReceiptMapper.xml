<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.egon.cola.component.tianshu.admin.dao.DdcI18nImportReceiptMapper">
    <resultMap id="Row" type="top.egon.cola.component.tianshu.admin.model.po.DdcI18nImportReceiptPO">
        <result property="id" column="id"/>
