<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.egon.cola.component.tianshu.admin.dao.DdcPublishAckMapper">
    <resultMap id="DdcPublishAckPOResultMap" type="top.egon.cola.component.tianshu.admin.model.po.DdcPublishAckPO">
        <id property="id" column="id"/>
        <result property="tenantId" column="tenant_id"/>
        <result property="createUserId" column="create_user_id"/>
        <result property="createTime" column="create_time"/>
        <result property="updateUserId" column="update_user_id"/>
        <result property="updateTime" column="update_time"/>
        <result property="deletedAt" column="deleted_at"/>
        <result property="version" column="version"/>
        <result property="publicId" column="public_id"/>
        <result property="changeId" column="change_id"/>
        <result property="instanceId" column="instance_id"/>
        <result property="leaseId" column="lease_id"/>
        <result property="resourceChecksum" column="content_checksum"/>
        <result property="bizCode" column="biz_code"/>
        <result property="appCode" column="app_code"/>
        <result property="env" column="env"/>
        <result property="namespace" column="namespace"/>
        <result property="resourceName" column="config_key"/>
        <result property="targetVersion" column="target_version"/>
        <result property="currentVersion" column="current_version"/>
        <result property="ackStatus" column="ack_status"/>
        <result property="errorMessage" column="error_message"/>
        <result property="ackAt" column="ack_at"/>
    </resultMap>
    <sql id="Columns">
        id, tenant_id, create_user_id, create_time, update_user_id, update_time, deleted_at, version, public_id,
        change_id, instance_id, lease_id, content_checksum, biz_code, app_code, env, namespace, config_key,
        target_version, current_version, ack_status, error_message, ack_at
    </sql>
    <select id="selectActiveById" resultMap="DdcPublishAckPOResultMap">
        SELECT <include refid="Columns"/> FROM ddc_publish_ack
        WHERE tenant_id = #{tenantId} AND id = #{id} AND deleted_at IS NULL
    </select>
    <select id="selectActiveByIds" resultMap="DdcPublishAckPOResultMap">
        SELECT <include refid="Columns"/> FROM ddc_publish_ack
        WHERE tenant_id = #{tenantId} AND deleted_at IS NULL AND id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
        ORDER BY change_id, instance_id, lease_id, id
    </select>
    <select id="selectByChangeId" resultMap="DdcPublishAckPOResultMap">
        SELECT <include refid="Columns"/> FROM ddc_publish_ack
        WHERE tenant_id = #{tenantId} AND change_id = #{changeId} AND deleted_at IS NULL
        ORDER BY instance_id, lease_id, id
    </select>
</mapper>
