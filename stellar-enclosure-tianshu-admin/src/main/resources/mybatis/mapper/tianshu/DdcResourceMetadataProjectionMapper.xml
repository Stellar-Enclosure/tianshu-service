<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.egon.cola.component.tianshu.admin.dao.DdcResourceMetadataProjectionMapper">
    <resultMap id="Row" type="top.egon.cola.component.tianshu.admin.model.po.DdcResourceMetadataProjectionPO">
        <result property="id" column="id"/>
        <result property="tenantId" column="tenant_id"/>
        <result property="createUserId" column="create_user_id"/>
        <result property="createTime" column="create_time"/>
        <result property="updateUserId" column="update_user_id"/>
        <result property="updateTime" column="update_time"/>
        <result property="deletedAt" column="deleted_at"/>
        <result property="version" column="version"/>
        <result property="catalogScopeId" column="catalog_scope_id"/>
        <result property="sourceId" column="source_id"/>
        <result property="producerId" column="producer_id"/>
        <result property="sourceVersion" column="source_version"/>
        <result property="metadataKind" column="metadata_kind"/>
        <result property="definitionKey" column="definition_key"/>
        <result property="resourceId" column="resource_id"/>
        <result property="permissionId" column="permission_id"/>
        <result property="resourceType" column="resource_type"/>
        <result property="definitionLifecycle" column="definition_lifecycle"/>
        <result property="pageCode" column="page_code"/>
        <result property="labelKey" column="label_key"/>
        <result property="descriptionKey" column="description_key"/>
        <result property="targetJson" column="target_json"/>
        <result property="policyJson" column="policy_json"/>
        <result property="i18nRefsJson" column="i18n_refs_json"/>
        <result property="referencedPermissionCodesJson" column="referenced_permission_codes_json"/>
    </resultMap>
    <select id="findBySource" resultMap="Row">
        SELECT * FROM ddc_resource_metadata_projection
        WHERE tenant_id=#{tenantId} AND catalog_scope_id=#{catalogScopeId} AND source_id=#{sourceId} AND deleted_at IS NULL
        ORDER BY id
    </select>
    <sql id="SelectedFilter">
        FROM ddc_resource_metadata_projection r
        JOIN ddc_catalog_activation_producer a ON a.tenant_id=r.tenant_id AND a.catalog_scope_id=r.catalog_scope_id AND a.source_id=r.source_id
        WHERE r.tenant_id=#{tenantId} AND r.catalog_scope_id=#{catalogScopeId} AND a.activation_projection_id=#{projectionId}
          AND r.deleted_at IS NULL AND a.deleted_at IS NULL
        <if test="filter.producerId != null">AND r.producer_id=#{filter.producerId}</if>
        <if test="filter.metadataKind != null">AND r.metadata_kind=#{filter.metadataKind}</if>
        <if test="filter.resourceType != null">AND r.resource_type=#{filter.resourceType}</if>
        <if test="filter.lifecycle != null">AND r.definition_lifecycle=#{filter.lifecycle}</if>
        <if test="filter.permissionCode != null">AND jsonb_exists(r.referenced_permission_codes_json::jsonb, #{filter.permissionCode})</if>
        <if test="filter.query != null">AND (r.definition_key ILIKE CONCAT('%', #{filter.query}, '%') ESCAPE '\'
            OR r.label_key ILIKE CONCAT('%', #{filter.query}, '%') ESCAPE '\')</if>
    </sql>
    <select id="search" resultMap="Row" timeout="2">
        SELECT r.* <include refid="SelectedFilter"/>
        ORDER BY r.metadata_kind, r.definition_key, r.id LIMIT #{limit} OFFSET #{offset}
    </select>
    <select id="countSearch" resultType="long" timeout="2">
        SELECT COUNT(*) <include refid="SelectedFilter"/>
    </select>
</mapper>
