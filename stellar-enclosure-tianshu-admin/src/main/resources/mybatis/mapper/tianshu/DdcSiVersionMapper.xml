<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.egon.cola.component.tianshu.admin.dao.DdcSiVersionMapper">
    <resultMap id="DdcSiVersionPOResultMap"
               type="top.egon.cola.component.tianshu.admin.model.po.DdcSiVersionPO">
        <id property="id" column="id"/>
        <result property="tenantId" column="tenant_id"/>
        <result property="createUserId" column="create_user_id"/>
        <result property="createTime" column="create_time"/>
        <result property="updateUserId" column="update_user_id"/>
        <result property="updateTime" column="update_time"/>
        <result property="deletedAt" column="deleted_at"/>
        <result property="version" column="version"/>
        <result property="resourceId" column="resource_id"/>
        <result property="versionNo" column="version_no"/>
        <result property="kind" column="kind"/>
        <result property="specJson" column="spec_json"/>
        <result property="dependencyManifestJson" column="dependency_manifest_json" jdbcType="OTHER"
                typeHandler="top.egon.cola.component.tianshu.admin.dao.typehandler.DdcJsonbTypeHandler"/>
        <result property="digestSha256" column="digest_sha256"/>
        <result property="sourceEnvCode" column="source_env_code"/>
        <result property="sourceVersionNo" column="source_version_no"/>
        <result property="changeNote" column="change_note"/>
        <result property="indexStatus" column="index_status"/>
        <result property="publishedTime" column="published_time"/>
        <result property="indexedTime" column="indexed_time"/>
        <result property="envCode" column="env_code"/>
    </resultMap>

    <sql id="VersionColumns">
        v.id, v.tenant_id, v.create_user_id, v.create_time, v.update_user_id, v.update_time, v.deleted_at, v.version,
        v.resource_id, v.version_no, v.kind, v.spec_json, v.dependency_manifest_json, v.digest_sha256, v.source_env_code, v.source_version_no,
        v.change_note, v.index_status, v.published_time, v.indexed_time, r.env_code AS env_code
    </sql>

    <sql id="ActiveVersionOwner">
        FROM ddc_si_version v
        JOIN ddc_si_resource r ON r.tenant_id = v.tenant_id AND r.id = v.resource_id
        WHERE v.tenant_id = #{tenantId} AND v.deleted_at IS NULL AND r.deleted_at IS NULL
    </sql>

    <select id="selectActiveById" resultMap="DdcSiVersionPOResultMap">
        SELECT <include refid="VersionColumns"/><include refid="ActiveVersionOwner"/> AND v.id = #{id}
    </select>

    <select id="selectActiveByIds" resultMap="DdcSiVersionPOResultMap">
        SELECT <include refid="VersionColumns"/><include refid="ActiveVersionOwner"/>
        AND v.id IN <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
        ORDER BY v.resource_id, v.version_no DESC, v.id DESC
    </select>

    <select id="selectNextVersionNo" resultType="long">
        SELECT COALESCE(MAX(v.version_no), 0) + 1
        FROM ddc_si_version v
        WHERE v.tenant_id = #{tenantId} AND v.resource_id = #{resourceId} AND v.deleted_at IS NULL
    </select>

    <select id="selectByResourceIdAndVersionNo" resultMap="DdcSiVersionPOResultMap">
        SELECT <include refid="VersionColumns"/><include refid="ActiveVersionOwner"/>
        AND v.resource_id = #{resourceId} AND v.version_no = #{versionNo}
    </select>

    <select id="selectPage" resultMap="DdcSiVersionPOResultMap">
        SELECT <include refid="VersionColumns"/><include refid="ActiveVersionOwner"/>
        AND v.resource_id = #{resourceId}
        ORDER BY v.version_no DESC, v.id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countPage" resultType="long">
        SELECT count(*) <include refid="ActiveVersionOwner"/> AND v.resource_id = #{resourceId}
    </select>

    <select id="selectEnvMatrixRows" resultMap="DdcSiVersionPOResultMap">
        SELECT <include refid="VersionColumns"/><include refid="ActiveVersionOwner"/>
        AND r.biz_code = #{bizCode}
        AND r.namespace_id = #{namespaceId}
        AND r.kind = #{kind}
        AND r.resource_key = #{resourceKey}
        AND r.current_version_id = v.id
        ORDER BY r.env_code ASC, v.version_no DESC
    </select>

    <update id="updateIndexStatus">
        UPDATE ddc_si_version
        SET index_status = #{indexStatus},
            indexed_time = #{indexedTime},
            version = version + 1,
            update_time = COALESCE(#{indexedTime}, CURRENT_TIMESTAMP)
        WHERE tenant_id = #{tenantId} AND id = #{versionId} AND deleted_at IS NULL
          AND dependency_manifest_json IS NOT NULL
    </update>
</mapper>
