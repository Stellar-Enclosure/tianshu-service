<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.egon.cola.component.tianshu.admin.dao.DdcInstanceMapper">
    <resultMap id="DdcInstancePOResultMap" type="top.egon.cola.component.tianshu.admin.model.po.DdcInstancePO">
        <id property="id" column="id"/>
        <result property="tenantId" column="tenant_id"/>
        <result property="createUserId" column="create_user_id"/>
        <result property="createTime" column="create_time"/>
        <result property="updateUserId" column="update_user_id"/>
        <result property="updateTime" column="update_time"/>
        <result property="deletedAt" column="deleted_at"/>
        <result property="version" column="version"/>
        <result property="publicId" column="public_id"/>
        <result property="instanceId" column="instance_id"/>
        <result property="bizCode" column="biz_code"/>
        <result property="appCode" column="app_code"/>
        <result property="env" column="env"/>
        <result property="namespace" column="namespace"/>
        <result property="host" column="host"/>
        <result property="port" column="port"/>
        <result property="pid" column="pid"/>
        <result property="sdkVersion" column="sdk_version"/>
        <result property="leaseId" column="lease_id"/>
        <result property="leaseExpireAt" column="lease_expire_at"/>
        <result property="resourceServerId" column="resource_server_id"/>
        <result property="resourceVersion" column="resource_version"/>
        <result property="credentialId" column="credential_id"/>
        <result property="admissionExpiresAt" column="admission_expires_at"/>
        <result property="status" column="status"/>
        <result property="lastHeartbeatAt" column="last_heartbeat_at"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="runtimeMetadata" column="runtime_metadata"
                typeHandler="top.egon.cola.component.tianshu.admin.model.convertor.DdcRuntimeMetadataTypeHandler"/>
    </resultMap>
    <sql id="Columns">
        id, tenant_id, create_user_id, create_time, update_user_id, update_time, deleted_at, version, public_id,
        instance_id, biz_code, app_code, env, namespace, host, port, pid, sdk_version, lease_id, lease_expire_at,
        resource_server_id, resource_version, credential_id, admission_expires_at, status, last_heartbeat_at,
        created_at, updated_at, runtime_metadata
    </sql>
    <select id="selectByInstanceId" resultMap="DdcInstancePOResultMap">
        SELECT <include refid="Columns"/> FROM ddc_instance
        WHERE tenant_id = #{tenantId} AND instance_id = #{instanceId} AND deleted_at IS NULL
    </select>
    <select id="selectByScope" resultMap="DdcInstancePOResultMap">
        SELECT <include refid="Columns"/> FROM ddc_instance
        WHERE tenant_id = #{tenantId} AND biz_code = #{bizCode} AND env = #{env} AND app_code = #{appCode}
          AND deleted_at IS NULL
        ORDER BY updated_at DESC, id DESC
    </select>
    <select id="selectPage" resultMap="DdcInstancePOResultMap">
        SELECT <include refid="Columns"/> FROM ddc_instance
        WHERE tenant_id = #{tenantId} AND biz_code = #{bizCode} AND env = #{env} AND app_code = #{appCode}
          AND deleted_at IS NULL
        ORDER BY updated_at DESC, id DESC LIMIT #{limit} OFFSET #{offset}
    </select>
    <select id="countPage" resultType="long">
        SELECT count(*) FROM ddc_instance WHERE tenant_id = #{tenantId} AND biz_code = #{bizCode}
          AND env = #{env} AND app_code = #{appCode} AND deleted_at IS NULL
    </select>
</mapper>
