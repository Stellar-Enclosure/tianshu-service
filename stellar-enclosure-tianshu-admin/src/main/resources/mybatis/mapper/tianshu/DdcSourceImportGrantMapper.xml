<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.egon.cola.component.tianshu.admin.dao.DdcSourceImportGrantMapper">
    <resultMap id="Row" type="top.egon.cola.component.tianshu.admin.model.po.DdcSourceImportGrantPO">
        <result property="id" column="id"/>
        <result property="tenantId" column="tenant_id"/>
        <result property="createUserId" column="create_user_id"/>
        <result property="createTime" column="create_time"/>
        <result property="updateUserId" column="update_user_id"/>
        <result property="updateTime" column="update_time"/>
        <result property="deletedAt" column="deleted_at"/>
        <result property="version" column="version"/>
        <result property="catalogScopeId" column="catalog_scope_id"/>
        <result property="producerId" column="producer_id"/>
        <result property="issuerUri" column="issuer_uri"/>
        <result property="clientId" column="client_id"/>
        <result property="resourceUri" column="resource_uri"/>
        <result property="principalBindingDigest" column="principal_binding_digest"/>
        <result property="enabled" column="enabled"/>
    </resultMap>
    <select id="findEnabled" resultMap="Row" timeout="2">
        SELECT * FROM ddc_source_import_grant
        WHERE tenant_id=#{tenantId} AND catalog_scope_id=#{catalogScopeId} AND producer_id=#{producerId}
            AND principal_binding_digest=#{bindingDigest} AND enabled=true AND deleted_at IS NULL
    </select>
    <select id="lockEnabled" resultMap="Row" timeout="2">
        SELECT * FROM ddc_source_import_grant
        WHERE tenant_id=#{tenantId} AND catalog_scope_id=#{catalogScopeId} AND producer_id=#{producerId}
            AND principal_binding_digest=#{bindingDigest} AND enabled=true AND deleted_at IS NULL
        FOR SHARE
    </select>
</mapper>
